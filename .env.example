# Entorno
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Base de Datos PostgreSQL (ATLAS-BACKEND)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/atlas_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis (Bus, Cache y Holds)
REDIS_URL=redis://localhost:6379/0
REDIS_AVAILABILITY_CACHE_TTL=600
REDIS_SUPERFICIAL_WAIT_SECONDS=2.0
REDIS_OPERATION_TTL=600

# OAuth 2.0 y JWT
OAUTH_ISSUER=https://mcp.atlas.com
OAUTH_JWT_SECRET_KEY=change-this-in-production-super-secret-key-for-oauth
OAUTH_JWT_ALGORITHM=HS256
OAUTH_ACCESS_TOKEN_EXPIRE_SECONDS=3600
OAUTH_REFRESH_TOKEN_EXPIRE_DAYS=30
OAUTH_AUTH_CODE_EXPIRE_SECONDS=60

# MCP Slot Token Signing
MCP_TOKEN_SECRET=change-this-in-production-super-secret-key-for-mcp-slot-tokens
